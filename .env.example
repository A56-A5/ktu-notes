# Supabase (optional). Leave these empty to use local-only IndexedDB storage.
# No login is used: the notebook is shared and anyone with the site can edit it.
# Only the publishable/anon key belongs in the browser. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: use a different shared notebook on the same project. Defaults to "public".
# NEXT_PUBLIC_WORKSPACE=public
